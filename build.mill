//| - io.github.quafadas:sjsls_plugin_mill1_3.8:0.14.4
//| - com.lihaoyi::mill-contrib-buildinfo:$MILL_VERSION
package build

import mill.*, scalalib.*, publish.*
import mill.api.Task.Simple
import mill.util.VcsVersion
import mill.util.Jvm

// mill mill.scalalib.scalafmt.ScalafmtModule/

object V:
  val laminar: Dep = mvn"com.raquo::laminar::18.0.0-M5"
  val waypoint: Dep = mvn"com.raquo::waypoint::10.0.0-M7"
  val jsDom: Dep = mvn"org.scala-js::scalajs-dom::2.2.0"
  val fastparse: Dep = mvn"com.lihaoyi::fastparse::3.1.1"
  val vecxt: Dep = mvn"io.github.quafadas::vecxt::0.0.36"
  val spire: Dep = mvn"org.typelevel::spire::0.18.0"
  val scalaVersion = "3.8.2"
  val scalaJSVersion = "1.20.2"
  val munitVersion = "1.2.2"
  val webawesome = mvn"io.github.nguyenyou::webawesome-laminar::3.0.0"
  val playwrightVersion = build.pwV
end V

object PlaywrightSetup extends JavaModule:

  def mvnDeps = Seq(
    mvn"com.microsoft.playwright:playwright:${build.V.playwrightVersion}",
    mvn"com.microsoft.playwright:driver-bundle:${build.V.playwrightVersion}"
  )

  def mainClass = Some("com.microsoft.playwright.CLI")
end PlaywrightSetup

trait MathlifyPublishModule extends PublishModule, ScalaModule:
  def scalaVersion: Simple[String] = build.V.scalaVersion

  def publishVersion: Simple[String] = VcsVersion.vcsState().format()

  override def scalacOptions = super.scalacOptions() ++ Seq("-Wunused:imports")

  override def pomSettings = Task {
    PomSettings(
      description = "Making cross platform compute intense problems less vexing",
      organization = "io.github.quafadas",
      url = "https://github.com/Quafadas/mathlify",
      licenses = Seq(License.`Apache-2.0`),
      versionControl = VersionControl.github("quafadas", "mathlify"),
      developers = Seq(
        Developer("quafadas", "Simon Parten", "https://github.com/quafadas")
      )
    )
  }
end MathlifyPublishModule
