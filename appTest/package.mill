package build.appTest

import mill.*, scalalib.*, scalajslib.*

import mill.contrib.buildinfo.BuildInfo

object `package` extends ScalaModule with TestModule.Munit with BuildInfo:
  def scalaVersion = build.V.scalaVersion
  def testFramework = "munit.Framework"
  override def defaultTask(): String = "testForked"

  val buildInfoPackageName = "mathlify"

  override def buildInfoMembers = Task {
    val published = build.example.assembleSite()
    Task.log.info(s"Published example site to ${published.path}")
    Seq(
      BuildInfo.Value("publishDir", published.path.toString)
    )
  }

  def mvnDeps = Seq(
    mvn"org.scalameta::munit::1.2.4",
    mvn"com.microsoft.playwright:playwright:${build.V.playwrightVersion}",
    mvn"com.microsoft.playwright:driver-bundle:${build.V.playwrightVersion}"
  )
end `package`
